# Copiar a .env local para `vercel dev`. En producción, estas variables se
# configuran en el dashboard de Vercel (Project Settings → Environment Variables),
# nunca en el repositorio.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

AUTH_SECRET=
AUTH_TITO_USER=
AUTH_TITO_PASS=
AUTH_TITO_EMAIL=
AUTH_DIEGO_USER=
AUTH_DIEGO_PASS=
AUTH_DIEGO_EMAIL=

SECOP_SMTP_HOST=
SECOP_SMTP_PORT=587
SECOP_SMTP_USERNAME=
SECOP_SMTP_PASSWORD=
